[TEMPLATE]
# Supabase
VITE_SUPABASE_URL=https://raxcxddreghynthyvllh.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_LICENSE_SALT=PRECIOS_ALDIA_BODEGA_2026

# Google Apps Script endpoint (with token)
VITE_GOOGLE_SCRIPT_URL=your_google_script_url_here
NEXT_PUBLIC_BCV_API=https://script.google.com/macros/s/TU_URL/exec
BCV_TOKEN=your_bcv_token_here

# Exchange rate API
VITE_EXCHANGERATE_KEY=your_exchangerate_key_here

# Groq AI
VITE_GROQ_API_KEY=your_groq_api_key_here

# Upstash Redis (used by serverless API routes)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# E2E manual — cuenta y datos de prueba dedicados; nunca usar credenciales reales.
# `bun run test:e2e` omite la prueba si estas variables no están configuradas.
# Para ejecutar Módulo 1 automáticamente en este mismo proyecto, usa
# `bun run test:module1-e2e-current`; crea fixtures efímeras y las limpia.
E2E_CLOUD_EMAIL=e2e-test@example.invalid
E2E_CLOUD_PASSWORD=replace_with_test_password
E2E_STAFF_PIN=replace_with_test_pin
E2E_STAFF_NAME=Administrador E2E
E2E_TABLE_NAME=Mesa E2E
E2E_PRODUCT_NAME=Producto E2E
E2E_BASE_URL=http://127.0.0.1:4173
